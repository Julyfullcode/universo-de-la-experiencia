# Configuración del proxy público: únicamente clave publicable/anon.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Administración segregada: generar las claves con npm run admin:setup.
# Configurar solo en el servidor; no subir los valores reales a Git.
ADMIN_DATABASE_URL=postgresql://universo_admin_backend:REPLACE_ME@DATABASE_HOST:5432/postgres
ADMIN_COOKIE_KEY=REPLACE_WITH_BASE64_32_BYTES
ADMIN_MFA_KEY=REPLACE_WITH_DIFFERENT_BASE64_32_BYTES
ADMIN_ALLOWED_ORIGIN=https://YOUR_PRODUCTION_DOMAIN
ADMIN_CAPTCHA_PROVIDER=botid
# Solo si se elige ADMIN_CAPTCHA_PROVIDER=turnstile:
TURNSTILE_SITE_KEY=REPLACE_WITH_PRODUCTION_SITE_KEY
TURNSTILE_SECRET_KEY=REPLACE_WITH_PRODUCTION_SECRET_KEY
ADMIN_ALERT_PROVIDER=resend
RESEND_API_KEY=REPLACE_WITH_PRIVATE_EMAIL_API_KEY
ADMIN_ALERT_FROM=security@YOUR_VERIFIED_SENDING_DOMAIN
ADMIN_ALERT_RECIPIENTS=first@example.com,second@example.com
# Alternativa: ADMIN_ALERT_PROVIDER=webhook requiere las siguientes variables.
ADMIN_ALERT_WEBHOOK_URL=https://YOUR_ALERT_RECEIVER
ADMIN_ALERT_WEBHOOK_KEY=REPLACE_WITH_RANDOM_SIGNING_KEY
# Opcional: certificado CA PEM de la base; nunca desactivar validación TLS.
# ADMIN_DATABASE_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Programación del worker de alertas; generar con npm run admin:setup.
CRON_SECRET=REPLACE_WITH_RANDOM_SECRET
